# Copy to .env (Windows: copy .env.example .env) and change the secrets.
DB_NAME=subscriptiq
DB_USER=subscriptiq
DB_PASSWORD=change-me-db-password
DB_PORT=5433

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRY_MINUTES=480

# Demo accounts (only created when the database is empty and SEED_DEMO_DATA=true)
SEED_DEMO_DATA=true
ADMIN_PASSWORD=Admin@123
STAFF_PASSWORD=Staff@123

BACKEND_PORT=8080
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
